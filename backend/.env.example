# Copy to .env and fill in only what you need. The app runs with NONE of these set.

# --- AI content generation ---------------------------------------------------
# Default is "mock" (no credentials, realistic canned content). Set to "anthropic"
# for real Claude generation.
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5          # or claude-sonnet-5 for cheaper high-volume runs

# --- publish engine ----------------------------------------------------------
# Simulated failure rate for the mock publishers (0 = always succeed). Try 0.15
# to watch retries in the publish log.
WOLFIE_MOCK_FAILURE_RATE=0

# --- REAL Instagram publishing (optional; mock is used until BOTH are set) -----
# When META_ACCESS_TOKEN and META_IG_USER_ID are both present, the Instagram
# adapter publishes for real via the Meta Graph API. Requires (on your side):
#   1. An Instagram Business/Creator account linked to a Facebook Page
#   2. A Meta app with the instagram_content_publish permission
#   3. Advanced Access via Meta App Review (public apps) + a long-lived token
#   4. The Instagram Business account id (the "ig-user-id")
# Verify your setup without publishing: GET http://localhost:8000/api/integrations/meta/check
# META_ACCESS_TOKEN=
# META_IG_USER_ID=
# META_GRAPH_VERSION=v21.0
# Instagram REQUIRES a public media URL. Per-post media_url wins; else these fallbacks:
# META_DEFAULT_IMAGE_URL=https://example.com/your-image.jpg
# META_DEFAULT_VIDEO_URL=https://example.com/your-reel.mp4

# LINKEDIN_ACCESS_TOKEN=        # (not wired yet) requires LinkedIn partner access
